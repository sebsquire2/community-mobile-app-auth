# Required: must be one of development, dev, test, staging, production, prod
ENV=development

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/auth_showcase

# JWT — leave unset in dev/test (uses a safe default); MUST be set in staging/production
# JWT_SECRET=your-secret-here-min-32-chars

# Access token lifetime in minutes (default: 15)
# ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token lifetime in days (default: 7)
# REFRESH_TOKEN_EXPIRE_DAYS=7

# Argon2id tuning (increase for higher security, slower logins)
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST_KIB=65536
# ARGON2_PARALLELISM=2

# CORS — comma-separated list of allowed origins
# CORS_ALLOW_ORIGINS=http://localhost:8081,http://localhost:3000

# Admin API key — protects POST /auth/revoke-sessions
# MUST be set when ENV=staging/production; returns 503 otherwise
# ADMIN_API_KEY=your-admin-key-here

# Admin web panel (optional, disabled by default)
# ENABLE_ADMIN_PANEL=false
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-admin-password
# ADMIN_SESSION_SECRET=your-session-secret-here

# OAuth — Google
# GOOGLE_CLIENT_ID=your-google-client-id

# OAuth — Apple
# APPLE_CLIENT_ID=your-apple-client-id
